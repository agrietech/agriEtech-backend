// AgriEtech - Prisma Schema Definition
// Multi-Hazard Early Warning Database Schema for Ethiopia

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  FARMER
  DEVELOPMENT_AGENT
  WOREDA_OFFICER
  ZONAL_OFFICER
  REGIONAL_OFFICER
  RESEARCHER
  ADMIN
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestableRole {
  DEVELOPMENT_AGENT
  WOREDA_OFFICER
  ZONAL_OFFICER
  REGIONAL_OFFICER
  RESEARCHER
}

enum AgroZone {
  WURCH
  DEGA
  WEINA_DEGA
  KOLLA
  BEREHA
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum HazardType {
  DROUGHT
  FLOOD
  LOCUST_PEST
  VEGETATION_STRESS
  FROST
  HEAT_STRESS
}

enum DeliveryChannel {
  SMS
  USSD
  PUSH_NOTIFICATION
  WEBSOCKET
  EMAIL
}

enum AlertStatus {
  DRAFT
  ACTIVE
  DISPATCHED
  DELIVERED
  FAILED
  RESOLVED
}

model User {
  id                    String            @id @default(uuid())
  phoneNumber           String?           @unique
  email                 String?           @unique
  fullName              String
  passwordHash          String?
  role                  Role              @default(FARMER)
  preferredLang         String            @default("am") // 'am' for Amharic, 'en' for English, 'om' for Afaan Oromoo
  isEmailVerified       Boolean           @default(false)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  verificationToken     String?
  regionId              String?
  region                Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  zoneId                String?
  zone                  Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  woredaId              String?
  woreda                Woreda?           @relation(fields: [woredaId], references: [id], onDelete: SetNull)
  kebeleId              String?
  kebele                Kebele?           @relation(fields: [kebeleId], references: [id], onDelete: SetNull)
  kebeleName            String?
  deviceToken           String?
  fcmToken              String?
  notifications         Notification[]
  alertSubscriptions    AlertSubscription[]
  aiInsights            AIInsight[]
  farms                 Farm[]
  alertLogs             AlertDeliveryLog[]
  roleRequests          RoleRequest[]     @relation("RoleRequestUser")
  reviewedRequests      RoleRequest[]     @relation("RoleRequestReviewer")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([phoneNumber])
  @@index([email])
  @@index([regionId])
  @@index([zoneId])
  @@index([woredaId])
}

model Region {
  id               String            @id @default(uuid())
  code             String            @unique // e.g., 'ET-OR', 'ET-AM'
  nameEn           String
  nameAm           String?
  geojson          Json?             // Polygon boundary
  zones            Zone[]
  users            User[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Zone {
  id               String            @id @default(uuid())
  regionId         String
  region           Region            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  nameEn           String
  nameAm           String?
  geojson          Json?             // Polygon boundary
  woredas          Woreda[]
  users            User[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([regionId])
}

model Woreda {
  id               String            @id @default(uuid())
  zoneId           String
  zone             Zone              @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  nameEn           String
  nameAm           String?
  geojson          Json?             // Polygon boundary
  centerLat        Float
  centerLng        Float
  kebeles          Kebele[]
  farms            Farm[]
  users            User[]
  satelliteObs     SatelliteObservation[]
  riskAssessments  RiskAssessment[]
  alerts           Alert[]
  advisories       Advisory[]
  alertSubscriptions AlertSubscription[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([zoneId])
  @@index([centerLat, centerLng])
}

model Kebele {
  id               String            @id @default(uuid())
  woredaId         String
  woreda           Woreda            @relation(fields: [woredaId], references: [id], onDelete: Cascade)
  nameEn           String
  nameAm           String?
  nameOm           String?
  pcode            String?           @unique
  elevationMeters  Float?
  agroZone         AgroZone?         @default(WEINA_DEGA)
  dominantSoilType String?
  soilPh           Float?
  centerLat        Float
  centerLng        Float
  geojson          Json?
  ftcName          String?
  farms            Farm[]
  users            User[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([woredaId])
  @@index([centerLat, centerLng])
  @@index([agroZone])
}

model Farm {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  woredaId         String
  woreda           Woreda            @relation(fields: [woredaId], references: [id], onDelete: Restrict)
  kebeleId         String?
  kebele           Kebele?           @relation(fields: [kebeleId], references: [id], onDelete: SetNull)
  farmName         String
  areaHectares     Float?
  polygonGeojson   Json?
  latitude         Float
  longitude        Float
  primaryCrop      String?
  cropId           String?
  crop             Crop?             @relation(fields: [cropId], references: [id], onDelete: SetNull)
  soilType         String?
  irrigationType   String?
  sensors          Sensor[]
  diseaseDiagnoses DiseaseDiagnosis[]
  aiInsights       AIInsight[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([woredaId])
  @@index([kebeleId])
  @@index([latitude, longitude])
}

model Sensor {
  id               String            @id @default(uuid())
  farmId           String
  farm             Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  hardwareId       String            @unique
  sensorType       String            // SOIL_MOISTURE, TEMPERATURE, RAIN_GAUGE, LEAF_WETNESS
  isActive         Boolean           @default(true)
  readings         SensorReading[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([farmId])
  @@index([hardwareId])
}

model SensorReading {
  id               String            @id @default(uuid())
  sensorId         String
  sensor           Sensor            @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  soilMoisture     Float?
  soilTemp         Float?
  ambientTemp      Float?
  humidity         Float?
  rainfallMm       Float?
  batteryLevel     Float?
  recordedAt       DateTime
  createdAt        DateTime          @default(now())

  @@index([sensorId, recordedAt])
}

model SatelliteObservation {
  id               String            @id @default(uuid())
  woredaId         String
  woreda           Woreda            @relation(fields: [woredaId], references: [id], onDelete: Cascade)
  observationDate  DateTime
  source           String            // CHIRPS, MODIS, MODIS_NDVI, SENTINEL_1, SENTINEL_2, NASA_POWER, OPEN_METEO, GLOFAS, FAO_LOCUST, FAO_WAPOR
  chirpsRainfallMm Float?
  nasaPowerTempMax Float?
  nasaPowerTempMin Float?
  nasaPowerHumidity Float?
  nasaPowerSolarMJ Float?
  modisNdvi        Float?
  sentinel2Ndvi    Float?
  glofasDischarge  Float?
  soilMoistureSat  Float?
  soilClayPercent  Float?
  soilSandPercent  Float?
  soilSiltPercent  Float?
  soilOrganicCarbon Float?
  soilPh           Float?
  locustPresence   Boolean           @default(false)
  locustDensity    Float?
  ingestionStatus  String?           @default("SUCCESS") // SUCCESS, PARTIAL, FAILED
  rawPayload       Json?
  createdAt        DateTime          @default(now())

  @@unique([woredaId, observationDate, source], name: "woredaId_observationDate_source")
  @@index([woredaId, observationDate])
  @@index([source])
}

model RiskAssessment {
  id               String            @id @default(uuid())
  woredaId         String
  woreda           Woreda            @relation(fields: [woredaId], references: [id], onDelete: Cascade)
  assessmentDate   DateTime
  hazardType       HazardType?
  riskLevel        RiskLevel?
  riskScore        Float?            // 0.0 to 1.0 composite index
  droughtScore     Float?            // Individual hazard score 0.0-1.0
  floodScore       Float?
  locustScore      Float?
  vegetationScore  Float?
  compositeScore   Float?            // Weighted aggregate of all hazard scores
  alertLevel       String?           // GREEN, YELLOW, ORANGE, RED, CRITICAL
  spi30Day         Float?            // Standardized Precipitation Index 30-day
  spi90Day         Float?            // Standardized Precipitation Index 90-day
  dischargeAnomaly Float?
  ndviAnomaly      Float?
  locustRiskRadius Float?
  recommendationsEn String?
  recommendationsAm String?
  assessedAt       DateTime?         // When the assessment computation completed
  createdAt        DateTime          @default(now())

  @@index([woredaId, assessmentDate])
  @@index([hazardType, riskLevel])
  @@index([alertLevel])
}

model Alert {
  id               String            @id @default(uuid())
  woredaId         String
  woreda           Woreda            @relation(fields: [woredaId], references: [id], onDelete: Cascade)
  hazardType       HazardType
  severity         RiskLevel
  headline         String?           // Short summary headline
  status           AlertStatus       @default(ACTIVE)
  isRead           Boolean           @default(false)
  titleEn          String
  titleAm          String            @default("")
  titleOm          String?           // Afaan Oromoo title
  messageEn        String
  messageAm        String            @default("")
  messageOm        String?           // Afaan Oromoo message
  sentAt           DateTime?
  priority         Int               @default(1)
  actionItems      Json?
  expiresAt        DateTime?
  targetPhones     String[]          @default([])
  affectedAreaKm2  Float?
  advisories       Advisory[]
  deliveryLogs     AlertDeliveryLog[]
  createdAt        DateTime          @default(now())

  @@index([woredaId, severity])
  @@index([status])
  @@index([createdAt])
}

model AlertDeliveryLog {
  id               String            @id @default(uuid())
  alertId          String
  alert            Alert             @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          DeliveryChannel
  status           AlertStatus       @default(DRAFT)
  responsePayload  Json?
  sentAt           DateTime?
  createdAt        DateTime          @default(now())

  @@index([alertId])
  @@index([userId])
}

model DiseaseDiagnosis {
  id               String            @id @default(uuid())
  farmId           String?
  farm             Farm?             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  imageUrl         String
  cropType         String?
  cropIdentified   String?
  diseaseName      String?
  pathogen         String?
  severity         String?           @default("MODERATE") // LOW, MODERATE, HIGH, CRITICAL
  confidenceScore  Float?
  symptomsEn       String?
  symptomsAm       String?
  treatmentEn      String?
  treatmentAm      String?
  treatmentOm      String?
  preventionEn     String?
  preventionAm     String?
  rawResponse      Json?
  createdAt        DateTime          @default(now())

  @@index([farmId])
}

model AuditLog {
  id               String            @id @default(uuid())
  action           String            // SYSTEM_BOOT, USER_ROLE_UPDATED, MANUAL_INGESTION_TRIGGERED, etc.
  adminId          String?
  adminEmail       String?
  details          String?
  ipAddress        String?
  createdAt        DateTime          @default(now())

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
}

model RoleRequest {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("RoleRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  userName          String
  userPhone         String?
  userEmail         String?
  currentRole       Role              @default(FARMER)
  requestedRole     Role              // DEVELOPMENT_AGENT, WOREDA_OFFICER, RESEARCHER
  regionId          String
  regionName        String
  zoneId            String
  zoneName          String
  woredaId          String
  woredaName        String
  kebeleName        String?
  staffIdNumber     String            // Required employee badge/staff ID
  organizationName  String            // Required organization name
  status            RoleRequestStatus @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  reviewedBy        User?             @relation("RoleRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedByName    String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([woredaId])
  @@index([requestedRole])
  @@index([createdAt])
}

enum CropCategory {
  CEREAL
  PULSE
  OILSEED
  CASH_CROP
  VEGETABLE
  FRUIT
}

model Crop {
  id                    String       @id @default(uuid())
  code                  String       @unique // e.g., 'TEFF', 'WHEAT', 'MAIZE', 'COFFEE'
  nameEn                String
  nameAm                String
  nameOm                String?
  category              CropCategory @default(CEREAL)
  growingPeriodDays     Int?
  waterRequirementMm    Float?
  optimalSoilPhMin      Float?
  optimalSoilPhMax      Float?
  optimalTempMin        Float?
  optimalTempMax        Float?
  optimalElevationMin   Float?
  optimalElevationMax   Float?
  farms                 Farm[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([category])
  @@index([code])
}

model DataSourceSyncLog {
  id              String   @id @default(uuid())
  source          String   // 'CHIRPS', 'OPEN_METEO', 'NASA_POWER', 'GLOFAS', 'FAO_LOCUST', 'SOILGRIDS', 'MODIS_NDVI'
  status          String   // 'SUCCESS', 'PARTIAL', 'FAILED'
  recordsIngested Int      @default(0)
  recordsFailed   Int      @default(0)
  durationMs      Int      @default(0)
  errorMessage    String?
  metadata        Json?
  syncedAt        DateTime @default(now())

  @@index([source, syncedAt])
  @@index([status])
}

model Advisory {
  id          String      @id @default(uuid())
  alertId     String?
  alert       Alert?      @relation(fields: [alertId], references: [id], onDelete: SetNull)
  woredaId    String
  woreda      Woreda      @relation(fields: [woredaId], references: [id], onDelete: Cascade)
  cropType    String?
  hazardType  HazardType
  severity    RiskLevel
  titleEn     String
  titleAm     String
  titleOm     String?
  adviceEn    String
  adviceAm    String
  adviceOm    String?
  actionItems Json?
  issuedAt    DateTime    @default(now())
  validUntil  DateTime?
  status      String      @default("ACTIVE") // ACTIVE, EXPIRED, ARCHIVED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([woredaId, hazardType])
  @@index([issuedAt])
  @@index([status])
}

model AIInsight {
  id              String    @id @default(uuid())
  prompt          String
  model           String    @default("google/gemini-2.5-flash")
  feature         String    // 'DISEASE_DIAGNOSIS', 'ADVISORY', 'VOICE_ASSISTANT', 'RISK_PREDICTION'
  rawResponse     Json
  confidenceScore Float?
  latencyMs       Int?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  farmId          String?
  farm            Farm?     @relation(fields: [farmId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([feature])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleEn   String
  titleAm   String    @default("")
  bodyEn    String
  bodyAm    String    @default("")
  type      String    @default("ALERT") // 'ALERT', 'ADVISORY', 'SYSTEM', 'SENSOR_BREACH'
  isRead    Boolean   @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model UssdSession {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  phoneNumber String
  serviceCode String?  @default("*212#")
  text        String?
  currentStep String   @default("HOME")
  sessionData Json?
  isActive    Boolean  @default(true)
  language    String   @default("am")
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
  @@index([sessionId])
  @@index([updatedAt])
}

model AlertSubscription {
  id            String          @id @default(uuid())
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  phoneNumber   String
  woredaId      String
  woreda        Woreda          @relation(fields: [woredaId], references: [id], onDelete: Cascade)
  hazardTypes   HazardType[]
  channel       DeliveryChannel @default(SMS)
  preferredLang String          @default("am")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([woredaId, isActive])
  @@index([phoneNumber])
}

